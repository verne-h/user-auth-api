NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379
TRUST_PROXY=false
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
CREATE_USER_RATE_LIMIT_WINDOW_MS=60000
CREATE_USER_RATE_LIMIT_MAX=5
REQUEST_BODY_LIMIT=16kb

# Required in production. Generate a high-entropy secret, for example:
# openssl rand -base64 48
# Do not commit a production value to source control.
JWT_SECRET=
JWT_ISSUER=user-auth-api
JWT_AUDIENCE=user-auth-api-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
